{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "fonts/**/*", "outDir": "dist", "watchAssets": true },
      { "include": "assets/**/*", "outDir": "dist", "watchAssets": true },
      { "include": "public/**/*", "outDir": "dist", "watchAssets": true }
    ]
  }
}
