{
  "$description": "Supabase design tokens — Duply · https://duply.ai/supabase/design-md (v alpha)",
  "colors": {
    "brand": {
      "$value": "#3ecf8e",
      "$type": "color",
      "$description": "the Supabase green — primary buttons (`{component.button-primary}` with near-black `{colors.on-brand}` text), status dots, stat highlights, logo."
    },
    "brand-deep": {
      "$value": "#00c46b",
      "$type": "color"
    },
    "brand-tint": {
      "$value": "#0f2c20",
      "$type": "color",
      "$description": "green-washed badge and callout fills."
    },
    "canvas": {
      "$value": "#121212",
      "$type": "color"
    },
    "surface-low": {
      "$value": "#171717",
      "$type": "color"
    },
    "surface": {
      "$value": "#1f1f1f",
      "$type": "color"
    },
    "surface-raised": {
      "$value": "#212121",
      "$type": "color"
    },
    "surface-high": {
      "$value": "#292929",
      "$type": "color"
    },
    "ink": {
      "$value": "#ededed",
      "$type": "color"
    },
    "body": {
      "$value": "#a0a0a0",
      "$type": "color"
    },
    "muted": {
      "$value": "#7e7e7e",
      "$type": "color"
    },
    "quiet": {
      "$value": "#707070",
      "$type": "color"
    },
    "hairline": {
      "$value": "#2e2e2e",
      "$type": "color"
    },
    "hairline-strong": {
      "$value": "#3e3e3e",
      "$type": "color"
    },
    "hairline-veil": {
      "$value": "#ffffff14",
      "$type": "color"
    },
    "overlay-soft": {
      "$value": "#ffffff08",
      "$type": "color"
    },
    "on-brand": {
      "$value": "#0a0a0a",
      "$type": "color"
    },
    "inverse": {
      "$value": "#fcfcfc",
      "$type": "color"
    },
    "on-inverse": {
      "$value": "#171717",
      "$type": "color"
    },
    "warning": {
      "$value": "#f59e0b",
      "$type": "color"
    },
    "error": {
      "$value": "#ef4444",
      "$type": "color"
    }
  },
  "typography": {
    "display-xl": {
      "$value": {
        "fontSize": "56px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1.08,
        "letterSpacing": "-0.015em"
      },
      "$type": "typography"
    },
    "display-lg": {
      "$value": {
        "fontSize": "44px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1.1,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography"
    },
    "display-md": {
      "$value": {
        "fontSize": "32px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1.15,
        "letterSpacing": "-0.01em"
      },
      "$type": "typography"
    },
    "title-lg": {
      "$value": {
        "fontSize": "24px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1.3,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "title-md": {
      "$value": {
        "fontSize": "18px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1.4,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "body-md": {
      "$value": {
        "fontSize": "16px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "body-sm": {
      "$value": {
        "fontSize": "14px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "caption": {
      "$value": {
        "fontSize": "12px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "code": {
      "$value": {
        "fontSize": "14px",
        "fontFamily": "Source Code Pro, Office Code Pro, Menlo, monospace",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "button": {
      "$value": {
        "fontSize": "14px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1,
        "letterSpacing": 0
      },
      "$type": "typography"
    },
    "nav-link": {
      "$value": {
        "fontSize": "14px",
        "fontFamily": "Circular, Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": 0
      },
      "$type": "typography"
    }
  },
  "rounded": {
    "sm": {
      "$value": "4px",
      "$type": "dimension"
    },
    "md": {
      "$value": "6px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "8px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "12px",
      "$type": "dimension"
    },
    "pill": {
      "$value": "9999px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "spacing": {
    "xs": {
      "$value": "8px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "12px",
      "$type": "dimension"
    },
    "md": {
      "$value": "16px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "24px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "32px",
      "$type": "dimension"
    },
    "xxl": {
      "$value": "48px",
      "$type": "dimension"
    },
    "section": {
      "$value": "96px",
      "$type": "dimension"
    }
  },
  "$extensions": {
    "ai.duply": {
      "source": "https://duply.ai/supabase/design-md",
      "version": "alpha",
      "components": {
        "button-primary": {
          "height": "38px",
          "padding": "0 16px",
          "rounded": "{rounded.md}",
          "textColor": "{colors.on-brand}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.brand}"
        },
        "button-secondary": {
          "height": "38px",
          "padding": "0 16px",
          "rounded": "{rounded.md}",
          "textColor": "{colors.ink}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.surface-raised}"
        },
        "text-link": {
          "textColor": "{colors.brand-deep}",
          "typography": "{typography.body-sm}",
          "backgroundColor": "transparent"
        },
        "top-nav": {
          "height": "64px",
          "textColor": "{colors.ink}",
          "typography": "{typography.nav-link}",
          "backgroundColor": "{colors.canvas}"
        },
        "hero-band": {
          "padding": "96px",
          "textColor": "{colors.ink}",
          "typography": "{typography.display-xl}",
          "backgroundColor": "{colors.canvas}"
        },
        "feature-card": {
          "padding": "24px",
          "rounded": "{rounded.lg}",
          "textColor": "{colors.ink}",
          "typography": "{typography.title-md}",
          "backgroundColor": "{colors.surface-low}"
        },
        "product-frame": {
          "rounded": "{rounded.xl}",
          "backgroundColor": "{colors.surface}"
        },
        "code-block": {
          "padding": "16px",
          "rounded": "{rounded.lg}",
          "textColor": "{colors.ink}",
          "typography": "{typography.code}",
          "backgroundColor": "{colors.surface-raised}"
        },
        "badge-pill": {
          "padding": "2px 10px",
          "rounded": "{rounded.pill}",
          "textColor": "{colors.brand}",
          "typography": "{typography.caption}",
          "backgroundColor": "{colors.brand-tint}"
        },
        "text-input": {
          "height": "38px",
          "padding": "0 12px",
          "rounded": "{rounded.md}",
          "textColor": "{colors.ink}",
          "typography": "{typography.body-sm}",
          "backgroundColor": "{colors.surface-low}"
        },
        "stat-highlight": {
          "textColor": "{colors.brand}",
          "typography": "{typography.display-md}",
          "backgroundColor": "transparent"
        },
        "footer": {
          "padding": "64px",
          "textColor": "{colors.muted}",
          "typography": "{typography.body-sm}",
          "backgroundColor": "{colors.canvas}"
        }
      }
    }
  }
}