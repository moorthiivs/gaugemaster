{
  "$description": "shadcn-ui design tokens — Duply · https://duply.ai/ui/design-md (v alpha)",
  "colors": {
    "ink": {
      "$value": "#000000",
      "$type": "color",
      "$description": "The dominant text color — headlines, labels, primary body copy. The single most frequent computed color on the page."
    },
    "primary": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$description": "Near-black fill for primary CTAs (\"Build Your Own\", \"Create Goal\", \"Save Threshold\") and the black \"Button\" / \"Badge\" pills. Reads as black against white; distinct from pure `{colors.ink}` text."
    },
    "surface-dark": {
      "$value": "#171717",
      "$type": "color",
      "$description": "Dark chrome tone available for inverted controls (dark mode / dark button hovers in the kit)."
    },
    "surface-dark-elevated": {
      "$value": "#262626",
      "$type": "color",
      "$description": "A one-step-lighter dark surface for nesting on dark."
    },
    "body": {
      "$value": "#404040",
      "$type": "color",
      "$description": "Running text on light surfaces."
    },
    "muted": {
      "$value": "#737373",
      "$type": "color",
      "$description": "Secondary text — descriptions, captions, footer body."
    },
    "muted-soft": {
      "$value": "#a1a1a1",
      "$type": "color",
      "$description": "Tertiary text — placeholders, disabled labels, faint helper text."
    },
    "canvas": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "The page floor and card fill."
    },
    "surface-soft": {
      "$value": "#fafafa",
      "$type": "color",
      "$description": "Nested panels, sub-list backgrounds (\"Planning\", \"Support\"), muted input wells, savings tiles."
    },
    "surface-muted": {
      "$value": "#f5f5f5",
      "$type": "color",
      "$description": "Secondary button fill, subtle chip backgrounds."
    },
    "hairline": {
      "$value": "#e5e5e5",
      "$type": "color",
      "$description": "The 1px border tone on cards, inputs, and dividers."
    },
    "border-strong": {
      "$value": "#cccccc",
      "$type": "color",
      "$description": "Slightly heavier borders and disabled control outlines."
    },
    "on-primary": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Text/icon on black buttons and dark pills."
    },
    "accent-indigo": {
      "$value": "#3e43f0",
      "$type": "color",
      "$description": "The strongest chromatic accent, used sparingly inside product-UI fragments."
    },
    "accent-blue": {
      "$value": "#155dfc",
      "$type": "color"
    },
    "accent-blue-deep": {
      "$value": "#1447e6",
      "$type": "color"
    },
    "accent-blue-bright": {
      "$value": "#3080ff",
      "$type": "color"
    },
    "accent-blue-soft": {
      "$value": "#eff6ff",
      "$type": "color",
      "$description": "A blue family for links, focus rings, and info states shown inside the demo cards."
    },
    "accent-red": {
      "$value": "#e40014",
      "$type": "color"
    },
    "accent-red-soft": {
      "$value": "#ff6568",
      "$type": "color",
      "$description": "Danger / destructive states (e.g. the \"Danger Zone\" row)."
    },
    "accent-cream": {
      "$value": "#f6f7eb",
      "$type": "color",
      "$description": "A soft warm tint measured on a small highlight surface."
    }
  },
  "typography": {
    "h1": {
      "$value": {
        "fontSize": "48px",
        "fontFamily": "Geist, sans-serif",
        "fontWeight": 600,
        "lineHeight": 1.1,
        "letterSpacing": "-0.05em"
      },
      "$type": "typography"
    },
    "body": {
      "$value": {
        "fontSize": "18px",
        "fontFamily": "Geist, sans-serif",
        "fontWeight": 400,
        "lineHeight": 1.556,
        "letterSpacing": "normal"
      },
      "$type": "typography"
    },
    "button": {
      "$value": {
        "fontSize": "14px",
        "fontFamily": "Geist, sans-serif",
        "fontWeight": 500,
        "lineHeight": 1.429,
        "letterSpacing": "normal"
      },
      "$type": "typography"
    }
  },
  "rounded": {
    "xs": {
      "$value": "6px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "md": {
      "$value": "10px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "14px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "18px",
      "$type": "dimension"
    },
    "xxl": {
      "$value": "20px",
      "$type": "dimension"
    },
    "xxxl": {
      "$value": "24px",
      "$type": "dimension"
    }
  },
  "spacing": {
    "xxs": {
      "$value": "4px",
      "$type": "dimension"
    },
    "xs": {
      "$value": "6px",
      "$type": "dimension"
    },
    "sm": {
      "$value": "8px",
      "$type": "dimension"
    },
    "smd": {
      "$value": "10px",
      "$type": "dimension"
    },
    "md": {
      "$value": "12px",
      "$type": "dimension"
    },
    "mdl": {
      "$value": "14px",
      "$type": "dimension"
    },
    "lg": {
      "$value": "16px",
      "$type": "dimension"
    },
    "xl": {
      "$value": "20px",
      "$type": "dimension"
    },
    "xxl": {
      "$value": "24px",
      "$type": "dimension"
    },
    "xxxl": {
      "$value": "48px",
      "$type": "dimension"
    },
    "section": {
      "$value": "80px",
      "$type": "dimension"
    }
  },
  "$extensions": {
    "ai.duply": {
      "source": "https://duply.ai/ui/design-md",
      "version": "alpha",
      "components": {
        "top-nav": {
          "textColor": "{colors.ink}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.canvas}"
        },
        "hero-band": {
          "padding": "80px",
          "textColor": "{colors.ink}",
          "typography": "{typography.h1}",
          "backgroundColor": "{colors.canvas}"
        },
        "button-primary": {
          "padding": "8px 16px 8px 12px",
          "rounded": "{rounded.md}",
          "textColor": "{colors.on-primary}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.primary}"
        },
        "button-secondary": {
          "rounded": "{rounded.md}",
          "textColor": "{colors.ink}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.surface-muted}"
        },
        "button-outline": {
          "rounded": "{rounded.md}",
          "textColor": "{colors.ink}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.canvas}"
        },
        "badge-pill": {
          "rounded": "{rounded.xxl}",
          "textColor": "{colors.on-primary}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.primary}"
        },
        "card": {
          "rounded": "{rounded.md}",
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.canvas}"
        },
        "showcase-card": {
          "rounded": "{rounded.xl}",
          "textColor": "{colors.ink}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.canvas}"
        },
        "nested-panel": {
          "rounded": "{rounded.lg}",
          "textColor": "{colors.body}",
          "typography": "{typography.body}",
          "backgroundColor": "{colors.surface-soft}"
        },
        "input": {
          "rounded": "0px",
          "textColor": "{colors.ink}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.canvas}"
        },
        "footer": {
          "textColor": "{colors.muted}",
          "typography": "{typography.button}",
          "backgroundColor": "{colors.canvas}"
        }
      }
    }
  }
}